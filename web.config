<?xml version="1.0" encoding="UTF-8"?>
<!-- Ochrana pre Windows hosting (IIS), ktorý nečíta súbory .htaccess. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="data" />
          <add segment="app" />
          <add segment="cron" />
          <add segment="docker" />
          <add segment="config.php" />
          <add segment="config.local.php" />
          <add segment="config.local.example.php" />
          <add segment="README.md" />
          <add segment="Dockerfile" />
          <add segment="docker-compose.yml" />
          <add segment=".user.ini" />
          <add segment=".gitignore" />
          <add segment=".dockerignore" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
