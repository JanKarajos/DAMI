Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.local\.php|config\.local\.example\.php|README\.md|\.gitignore|\.dockerignore|\.user\.ini|Dockerfile|docker-compose\.yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
